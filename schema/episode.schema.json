{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phyzical.org/schema/episode.schema.json",
  "title": "phyzical episode v1",
  "description": "A single browser-teleoperation demonstration episode recorded by phyzical.org. Designed to convert losslessly into the elizaOS eliza_robot trajectory_db schema (see schema/MAPPING.md).",
  "type": "object",
  "required": ["episode_id", "task_id", "contributor", "sim", "duration_s", "success", "trajectory"],
  "properties": {
    "schema": { "const": "phyzical-episode-v1" },
    "episode_id": { "type": "string", "description": "Unique episode identifier, e.g. EP_a41b7c2e" },
    "task_id": { "type": "string", "description": "Task identifier, e.g. block_sorting_01" },
    "task_description": { "type": "string", "description": "Natural-language task instruction (VLA language conditioning)" },
    "contributor": { "type": "string", "description": "Contributor wallet address (provenance subject)" },
    "robot_profile": { "type": "string", "description": "Robot morphology identifier; aligns with elizaOS RobotProfileId where applicable" },
    "control_mode": { "type": "string", "enum": ["ee_drag_ik", "joint_sliders", "policy_takeover", "auto_patrol", "flycns"], "default": "ee_drag_ik" },
    "controller": {
      "type": "string",
      "enum": ["human_ik_v1", "auto_patrol_v1", "flycns_v1"],
      "description": "Actions source. Written into on-chain provenance metadata so datasets can be filtered by controller (human / auto / flycns)."
    },
    "fly": {
      "type": "object",
      "description": "Present when controller=flycns_v1. Connectome-controller metadata; see docs/flycns.md.",
      "required": ["graph", "photoreceptors"],
      "properties": {
        "graph": { "type": "string", "description": "Wiring profile id, e.g. malecns_v1_visual_crop" },
        "photoreceptors": {
          "type": "object",
          "properties": {
            "r1r6": { "type": "integer", "description": "R1-R6 cells in the source crop (MaleCNS v1.0: 3335)" },
            "r8": { "type": "integer", "description": "R7/R8 cells in the source crop (MaleCNS v1.0: 811)" }
          }
        },
        "ommatidia_sampled": { "type": "integer", "description": "Pooled ommatidia the runtime actually samples (61)" },
        "readout": { "type": "array", "items": { "type": "string" }, "description": "Descending-neuron readout cells, e.g. DNp20, DNpe017" },
        "teach_events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["t", "cell", "kind"],
            "properties": {
              "t": { "type": "number", "description": "Seconds since episode start" },
              "cell": { "type": "string", "enum": ["PPL101", "PAM"] },
              "kind": { "type": "string", "enum": ["aversive", "reward"] },
              "ms": { "type": "number", "description": "Modulation pulse duration" }
            }
          }
        }
      }
    },
    "sim": {
      "type": "object",
      "required": ["engine"],
      "properties": {
        "engine": { "type": "string", "enum": ["unity_webgl", "mujoco", "isaac"] },
        "physics_hz": { "type": "number" },
        "record_hz": { "type": "number" }
      }
    },
    "duration_s": { "type": "number", "minimum": 0 },
    "success": { "type": "boolean", "description": "Task success criteria met (checked in-scene)" },
    "trajectory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["t", "joint_pos", "ee_pose"],
        "properties": {
          "t": { "type": "number", "description": "Seconds since episode start" },
          "joint_pos": { "type": "array", "items": { "type": "number" }, "description": "Joint positions in radians (gripper aperture last, in meters)" },
          "joint_vel": { "type": "array", "items": { "type": "number" } },
          "joint_targets": { "type": "array", "items": { "type": "number" } },
          "ee_pose": {
            "type": "object",
            "required": ["xyz"],
            "properties": {
              "xyz": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
              "quat": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 }
            }
          },
          "gripper": { "type": "number", "description": "Gripper aperture in meters" },
          "object_poses": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "xyz": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
                "quat": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 }
              }
            }
          },
          "action": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["ee_delta", "joint_delta", "gripper"] },
              "cmd": { "type": "array", "items": { "type": "number" } }
            }
          },
          "dn_readout": {
            "type": "object",
            "description": "Fly episodes only: descending-neuron scalars for this frame",
            "properties": {
              "turn": { "type": "number" },
              "lift": { "type": "number" },
              "drive": { "type": "number" },
              "grip": { "type": "number" }
            }
          },
          "fly_stim": {
            "type": "object",
            "description": "Fly episodes only: photoreceptor stimulus summary for this frame",
            "properties": {
              "mean": { "type": "number" },
              "habituation": { "type": "number", "description": "0 = fresh stimulus, 1 = fully habituated (QC rejects sustained highs)" }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "data_id": { "type": "string", "description": "Onchain Data ID, e.g. phyz:robinhood:0x…" },
        "content_hash": { "type": "string", "description": "sha256 of the canonical episode payload" },
        "anchored_at": { "type": ["string", "null"], "description": "Block reference once anchored" }
      }
    }
  }
}
